# RepoMan process settings. Copy to "repoman.env" next to the binary (Windows, macOS) or to
# /etc/repoman/repoman.env (Linux service). Real environment variables override this file.
# Everything else (repositories, users, single sign-on, notifications) is configured in the web UI.
# Full reference: docs/configuration.md

# Listen address. ":8081" = all interfaces; "127.0.0.1:8081" = this machine only (behind a reverse proxy).
RM_ADDR=:8081

# Where the database and all artifacts live. Back this directory up.
RM_DATA_DIR=data

# Password of the "admin" account, used ONLY on the very first start. Leave unset to have a random
# one generated; it is printed in the log and saved as <data dir>/initial-admin-password.
# RM_ADMIN_PASSWORD=

# Serve HTTPS directly (PEM files). The certificate is re-read when the file changes.
# RM_TLS_CERT=/etc/repoman/fullchain.pem
# RM_TLS_KEY=/etc/repoman/privkey.pem

# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host headers are trusted.
# Comma-separated IPs or CIDR ranges. Default: loopback only (127.0.0.0/8, ::1).
# RM_TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12

# Also write the log to this file (rotated at 20 MB, 5 old files kept).
# RM_LOG_FILE=/var/log/repoman/repoman.log

# Set to false to stop logging every HTTP request.
# RM_ACCESS_LOG=true

# Outbound HTTP proxy for reaching upstream repositories (standard variables).
# HTTPS_PROXY=http://proxy.internal:3128
# NO_PROXY=localhost,127.0.0.1,.internal

# Extra certificate authorities for upstreams signed by a private CA (Linux/macOS).
# SSL_CERT_FILE=/etc/repoman/ca-bundle.pem
